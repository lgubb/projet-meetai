{
  "name": "@jean/bridge-cli",
  "version": "0.1.0",
  "type": "module",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md"
  ],
  "bin": {
    "jean-bridge": "./dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "node --test --import tsx src/*.test.ts"
  },
  "dependencies": {
    "@jean/shared": "workspace:*",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
