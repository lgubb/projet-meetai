{
  "name": "projet-meetai",
  "version": "1.0.0",
  "private": true,
  "description": "Workroom V1 monorepo",
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "dev": "turbo dev",
    "dev:local": "DATABASE_URL=${DATABASE_URL:-postgresql://localhost:5432/workroom} WORKROOM_AUTH_MODE=dev LIVEKIT_URL=${LIVEKIT_URL:-ws://127.0.0.1:7880} LIVEKIT_API_KEY=${LIVEKIT_API_KEY:-dev-key} LIVEKIT_API_SECRET=${LIVEKIT_API_SECRET:-dev-secret} WORKROOM_ROOM_WORKER_MODE=mock WORKROOM_ROOM_ID=${WORKROOM_ROOM_ID:-dev-local-room} turbo dev --filter=@jean/api --filter=@jean/web --filter=@jean/room-worker",
    "dev:api:local": "DATABASE_URL=${DATABASE_URL:-postgresql://localhost:5432/workroom} WORKROOM_AUTH_MODE=dev LIVEKIT_URL=${LIVEKIT_URL:-ws://127.0.0.1:7880} LIVEKIT_API_KEY=${LIVEKIT_API_KEY:-dev-key} LIVEKIT_API_SECRET=${LIVEKIT_API_SECRET:-dev-secret} pnpm --filter @jean/api dev",
    "dev:bridge": "pnpm --filter @jean/bridge-cli dev -- start",
    "bridge:doctor": "pnpm --filter @jean/bridge-cli dev -- doctor",
    "bridge:login": "pnpm --filter @jean/bridge-cli dev -- login",
    "bridge:agents": "pnpm --filter @jean/bridge-cli dev -- agents list",
    "bridge:smoke:package": "node scripts/bridge-package-smoke.mjs",
    "dev:web": "pnpm --filter @jean/web dev",
    "dev:room-worker": "pnpm --filter @jean/room-worker dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test": "turbo test",
    "db:generate": "turbo db:generate",
    "db:deploy": "turbo db:deploy",
    "db:migrate": "turbo db:migrate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.0.0",
    "turbo": "^2.8.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  }
}
